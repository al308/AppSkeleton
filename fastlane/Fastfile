default_platform(:ios)

# Reverse-DNS app id — keep in sync with app.json + Appfile.
APP_ID = "com.example.app".freeze # TODO(you)
APP_NAME = "MyApp".freeze # TODO(you)
APP_VERSION = "1.0.0".freeze # TODO(you) — the App Store version to create/edit

# ── Why fastlane *here* ───────────────────────────────────────────────────────
# This manages the App Store *listing* (text metadata + screenshots) via the
# App Store Connect API. The app *binary* ships with `eas submit` — these lanes
# never upload a binary and never auto-submit for review.

# App Store Connect API key from environment (see fastlane/README.md):
#   ASC_KEY_ID, ASC_ISSUER_ID, and either ASC_KEY_PATH (path to .p8)
#   or ASC_KEY_CONTENT (raw/base64 .p8 contents).
def asc_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV["ASC_KEY_PATH"],
    key_content: ENV["ASC_KEY_CONTENT"],
    is_key_content_base64: ENV["ASC_KEY_CONTENT_BASE64"] == "true"
  )
end

# Shared deliver options. Pass the API key explicitly (relying on lane_context
# alone has proven flaky — deliver then falls back to legacy Apple-ID auth and
# fails with "team_id nil").
def deliver_common
  {
    api_key: asc_key,
    app_identifier: APP_ID,
    app_version: APP_VERSION,
    submit_for_review: false,
    automatic_release: false,
    force: true, # skip the HTML preview / confirmation prompt
    skip_binary_upload: true,
    run_precheck_before_submit: false,
    precheck_include_in_app_purchases: false,
    overwrite_screenshots: true
  }
end

platform :ios do
  desc "Push App Store text metadata + screenshots (no binary, no review submit)"
  lane :metadata do
    deliver(**deliver_common, skip_screenshots: false)
  end

  desc "Push text metadata only"
  lane :text do
    deliver(**deliver_common, skip_screenshots: true)
  end

  desc "Push screenshots only"
  lane :screenshots do
    deliver(**deliver_common, skip_metadata: true, skip_screenshots: false)
  end

  desc "Read-only check of what's ACTUALLY live on App Store Connect"
  lane :status do
    script = File.expand_path("scripts/asc-status.rb", __dir__)
    sh("APP_BUNDLE_ID=#{APP_ID} ruby #{script.shellescape}")
  end

  desc "Download the live metadata into fastlane/metadata (overwrites local)"
  lane :pull do
    deliver(
      api_key: asc_key,
      app_identifier: APP_ID,
      download_metadata: true,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true
    )
  end

  # ⚠️ The App Store Connect API has NO create-app endpoint, so the API key
  # CANNOT create apps. `produce` then falls back to Apple ID and errors with
  # "No value found for 'username'". Create the app ONCE in the App Store
  # Connect UI (Apps → +), or run produce with an Apple ID (apple_id in Appfile
  # / PRODUCE_USERNAME). After the app exists, the `metadata` lane works with
  # just the API key.
  desc "Create the app record (needs an Apple ID; API key alone cannot create apps)"
  lane :create_app do
    produce(
      app_identifier: APP_ID,
      app_name: APP_NAME,
      language: "English (U.S.)",
      app_version: APP_VERSION,
      sku: APP_ID # SKU is permanent; any unique string works
    )
  end
end
