# Copy to fastlane/.env (gitignored) and fill in. fastlane auto-loads it.
# App Store Connect API key — see fastlane/README.md.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Path to the .p8 (relative to repo root). The *.p8 file itself is gitignored.
ASC_KEY_PATH=AuthKey_XXXXXXXXXX.p8
# Bundle id, for fastlane/scripts/asc-status.rb
APP_BUNDLE_ID=com.example.app
