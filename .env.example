# Copy this file to .env and fill in real values.
# .env is gitignored and never committed.
#
# Variables prefixed EXPO_PUBLIC_ are inlined into the JS bundle and visible
# to anyone with the app. Do NOT put secrets there.

# EXPO_PUBLIC_API_URL=https://api.example.com
# EXPO_PUBLIC_SENTRY_DSN=https://...

# Server-side only (used by EAS / build scripts):
# SENTRY_AUTH_TOKEN=
