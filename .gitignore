# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Expo
.expo/
.expo-shared/
dist/
web-build/

# Native projects (generated by `expo prebuild`)
ios/
android/

# Build outputs
*.tsbuildinfo
*.jsbundle

# Test / coverage
coverage/

# Editors / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs / runtime
*.log
*.pid
*.seed

# Secrets / local env
.env
.env.*
!.env.example

# Claude local overrides
.claude/settings.local.json

# Misc
*.bak
*.tmp

# App Store Connect API private keys — never commit
*.p8
AuthKey_*.p8

# Google Play service-account key — a .json, so the credential globs miss it.
# Used by `eas submit -p android` and fastlane supply. Never commit.
play-service-account.json

# Local build artifacts (eas build --local output)
*.aab
*.apk
*.ipa
